# Même fichier que backend/.env — pour lancer uvicorn hors Docker (Postgres sur localhost:5431).

DATABASE_URL=postgresql+psycopg2://audio:audio@localhost:5431/audio_db
SECRET_KEY=dev-secret-change-me-in-production
PORT=8000

ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123

# FRONTEND_STATIC_DIR laissé vide → backend/app/main.py pointe vers ../frontend
AUDIO_STORAGE_DIR=./data/audio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_TOKEN=dev-twilio-token

OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=gpt-audio-mini
OPENAI_JSON_FIX_MODEL=gpt-4o-mini

REACTIVATION_WEBHOOK_TOKEN=dev-reactivation-token
# URL à configurer dans les subscriptions push GCP (CRM + Hopti) :
#   https://<tunnl-host>/api/webhooks-reactivation?token=<REACTIVATION_WEBHOOK_TOKEN>
# Local dev (tunnel → module audio port 8000, PAS /push sms-success-echo) :
#   gcloud pubsub subscriptions modify-push-config local-dev-hopti-sms-success-push \
#     --project=smartconvers-saas \
#     --push-endpoint="https://<tunnl-host>/api/webhooks-reactivation?token=dev-reactivation-token"
# Topics attendus :
#   crm-workflow-events  → event crm.workflow.event (step SEND_WEBHOOK / SEND_SMS)
#   hopti-sms-success    → event sms.success (welcome SMS accepté)
TEXTMEBOT_ENABLED=0
